# copy to .env next to docker-compose.yml

# image tag published by .github/workflows/docker-5090.yml: latest | master | sha-<short> | pr-<nr>
LLAMA_TAG=latest
# missing (default) | always: re-pull a moving tag such as pr-<nr> on every start
LLAMA_PULL_POLICY=missing

# host directory with GGUF files, mounted read-only at /models
MODELS_DIR=/srv/models
# model file relative to MODELS_DIR (server, bench, profile)
LLAMA_MODEL=model.gguf

# server
LLAMA_PORT=8080
LLAMA_NGL=999
LLAMA_CTX=8192
LLAMA_FA=on
# extra llama-server arguments, e.g. "--backend-sampling --n-cpu-moe 8"
LLAMA_SERVER_ARGS=

# bench / profile: arguments after -m
LLAMA_BENCH_ARGS=-fa 1 -p 512 -n 128

# GPU selection and resources
CUDA_VISIBLE_DEVICES=0
LLAMA_SHM_SIZE=2g

# nsys / ncu reports (host path, must be writable)
REPORTS_DIR=./reports
